DATABASE_URL=                   # Neon POOLED string, written by `neon link` (app runtime)
DATABASE_URL_UNPOOLED=          # Neon direct string (migrations only)
GEMINI_API_KEY=
GEMINI_MODEL=                   # current stable Flash id from Google docs
RESEND_API_KEY=                 # provided by me
RESEND_FROM=onboarding@resend.dev
EMAIL_MODE=test                 # test | live. Default test.
TEST_RECIPIENT_EMAIL=           # the MESA test address
DASHBOARD_PASSWORD=
SHORTLIST_SIZE=5
SCORING_PASSES=2
BULK_SEND_ENABLED=false          # unset or anything other than "true" disables /api/send/bulk (403). No UI calls it yet.
